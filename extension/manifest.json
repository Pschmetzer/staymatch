{
  "manifest_version": 3,
  "name": "StayMatch – Unterkunfts-Merkzettel",
  "version": "0.5.0",
  "description": "Bewertet jede Unterkunft auf der Suchseite nach Budget, Sternen und Wünschen und zeigt die Top 3. Alles lokal.",
  "minimum_chrome_version": "110",
  "incognito": "not_allowed",
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self'; connect-src 'none'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StayMatch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.airbnb.de/*",
        "https://www.airbnb.com/*",
        "https://www.airbnb.at/*",
        "https://www.airbnb.ch/*",
        "https://www.airbnb.co.uk/*",
        "https://www.airbnb.fr/*",
        "https://www.airbnb.es/*",
        "https://www.airbnb.it/*",
        "https://www.airbnb.nl/*",
        "https://www.airbnb.pt/*",
        "https://www.airbnb.pl/*",
        "https://www.airbnb.be/*",
        "https://www.airbnb.dk/*",
        "https://www.airbnb.se/*",
        "https://www.airbnb.no/*",
        "https://www.airbnb.fi/*",
        "https://www.airbnb.ie/*",
        "https://www.airbnb.gr/*",
        "https://www.airbnb.cz/*",
        "https://www.airbnb.com.au/*",
        "https://www.airbnb.ca/*",
        "https://www.airbnb.co.nz/*",
        "https://www.airbnb.mx/*",
        "https://www.airbnb.com.br/*"
      ],
      "exclude_matches": [
        "https://*/book/*",
        "https://*/account-settings/*",
        "https://*/hosting/*",
        "https://*/messaging/*",
        "https://*/payments/*"
      ],
      "js": [
        "core.js",
        "parse.js",
        "rank.js",
        "hints.js",
        "extras.js",
        "pool.js",
        "content-common.js",
        "content-search.js",
        "content-listing.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://staymatch-tau.vercel.app/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}