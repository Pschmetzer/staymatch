{
  "name": "staymatch",
  "version": "0.5.0",
  "private": true,
  "description": "StayMatch: Viertel-Finder (web/) und Chrome-Erweiterung (extension/). Keine Abhängigkeiten.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Pschmetzer/staymatch.git" },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.js",
    "build": "./scripts/build-plugin-zip.sh",
    "check:js": "node scripts/check-syntax.mjs",
    "check:html": "node .github/scripts/check-html.mjs",
    "check:domains": "node .github/scripts/check-domains.mjs",
    "check:size": "node .github/scripts/check-size.mjs",
    "check:links": "node .github/scripts/check-links.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:pages": "node scripts/build-city-pages.mjs --check",
    "check:feed": "node scripts/build-feed.mjs --check",
    "feed": "node scripts/build-feed.mjs",
    "check:zip": "node .github/scripts/check-zip.mjs",
    "check:static": "npm run check:js && npm run check:html && npm run check:domains && npm run check:size && npm run check:links && npm run check:data && npm run check:pages && npm run check:feed",
    "check": "npm run check:static && npm run build --silent && npm run check:zip",
    "data:reprocess": "node scripts/prefetch-cities.mjs --reprocess"
  }
}
