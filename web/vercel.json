{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/favicon.ico", "destination": "/favicon.svg", "permanent": true},
    {"source": "/de", "destination": "/", "permanent": true},
    {"source": "/english", "destination": "/en", "permanent": true},
    {"source": "/privacy", "destination": "/datenschutz", "permanent": true},
    {"source": "/datenschutzerklaerung", "destination": "/datenschutz", "permanent": true},
    {"source": "/imprint", "destination": "/impressum", "permanent": true},
    {"source": "/plugin", "destination": "/#plugin", "permanent": true},
    {"source": "/download", "destination": "/#plugin", "permanent": true},
    {"source": "/staedte/lisbon", "destination": "/staedte/lissabon", "permanent": true},
    {"source": "/staedte/prague", "destination": "/staedte/prag", "permanent": true},
    {"source": "/staedte/rome", "destination": "/staedte/rom", "permanent": true},
    {"source": "/staedte/vienna", "destination": "/staedte/wien", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"}, {"key": "Cross-Origin-Resource-Policy", "value": "same-site"}]},
    {"source": "/((?!app$).*)", "headers": [{"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.airbnb.de https://www.airbnb.com; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests"}]},
    {"source": "/app", "headers": [{"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee; object-src 'none'; base-uri 'self'; form-action 'self' https://www.airbnb.de https://www.airbnb.com; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests"}]},
    {"source": "/(fonts|vendor)/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000"}]},
    {"source": "/media/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000"}]},
    {"source": "/data/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source": "/(og\\.png|apple-touch-icon\\.png|favicon\\.svg)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source": "/(app|app-extra|core|scoring)\\.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/legal.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/.well-known/security.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]}
  ]
}
