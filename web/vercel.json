{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/favicon.ico", "destination": "/favicon.svg", "permanent": true},
    {"source": "/de", "destination": "/", "permanent": true},
    {"source": "/english", "destination": "/en", "permanent": true},
    {"source": "/privacy", "destination": "/datenschutz", "permanent": true},
    {"source": "/datenschutzerklaerung", "destination": "/datenschutz", "permanent": true},
    {"source": "/imprint", "destination": "/impressum", "permanent": true},
    {"source": "/plugin", "destination": "/#plugin", "permanent": true},
    {"source": "/download", "destination": "/#plugin", "permanent": true},
    {"source": "/staedte/lisbon", "destination": "/staedte/lissabon", "permanent": true},
    {"source": "/staedte/prague", "destination": "/staedte/prag", "permanent": true},
    {"source": "/staedte/rome", "destination": "/staedte/rom", "permanent": true},
    {"source": "/staedte/vienna", "destination": "/staedte/wien", "permanent": true},
    {"source": "/staedte/brussels", "destination": "/staedte/brussel", "permanent": true},
    {"source": "/staedte/bruessel", "destination": "/staedte/brussel", "permanent": true},
    {"source": "/staedte/bruxelles", "destination": "/staedte/brussel", "permanent": true},
    {"source": "/staedte/warsaw", "destination": "/staedte/warschau", "permanent": true},
    {"source": "/staedte/warszawa", "destination": "/staedte/warschau", "permanent": true},
    {"source": "/staedte/antwerp", "destination": "/staedte/antwerpen", "permanent": true},
    {"source": "/staedte/zuerich", "destination": "/staedte/zurich", "permanent": true},
    {"source": "/en/cities/lissabon", "destination": "/en/cities/lisbon", "permanent": true},
    {"source": "/en/cities/prag", "destination": "/en/cities/prague", "permanent": true},
    {"source": "/en/cities/rom", "destination": "/en/cities/rome", "permanent": true},
    {"source": "/en/cities/wien", "destination": "/en/cities/vienna", "permanent": true},
    {"source": "/en/cities/warschau", "destination": "/en/cities/warsaw", "permanent": true},
    {"source": "/en/cities/brussel", "destination": "/en/cities/brussels", "permanent": true},
    {"source": "/en/cities/antwerpen", "destination": "/en/cities/antwerp", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"}, {"key": "Cross-Origin-Resource-Policy", "value": "same-site"}]},
    {"source": "/((?!app$).*)", "headers": [{"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.airbnb.de https://www.airbnb.com; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests"}]},
    {"source": "/app", "headers": [{"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee; object-src 'none'; base-uri 'self'; form-action 'self' https://www.airbnb.de https://www.airbnb.com; frame-ancestors 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"}]},
    {"source": "/(fonts|vendor)/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000"}]},
    {"source": "/media/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000"}]},
    {"source": "/data/((?!index\\.json$).*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source": "/(og\\.png|apple-touch-icon\\.png|favicon\\.svg)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source": "/data/index\\.json", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/(app|app-extra|core|scoring)\\.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(site|legal)\\.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(sw\\.js|manifest\\.webmanifest)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/manifest\\.webmanifest", "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]},
    {"source": "/.well-known/security.txt", "headers": [{"key": "Content-Type", "value": "text/plain; charset=utf-8"}]}
  ]
}
