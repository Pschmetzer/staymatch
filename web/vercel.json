{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/favicon.ico", "destination": "/favicon.svg", "permanent": true },
    { "source": "/de", "destination": "/", "permanent": true },
    { "source": "/english", "destination": "/en", "permanent": true },
    { "source": "/privacy", "destination": "/datenschutz", "permanent": true },
    { "source": "/datenschutzerklaerung", "destination": "/datenschutz", "permanent": true },
    { "source": "/imprint", "destination": "/impressum", "permanent": true },
    { "source": "/plugin", "destination": "/#plugin", "permanent": true },
    { "source": "/download", "destination": "/#plugin", "permanent": true },
    { "source": "/staedte/lisbon", "destination": "/staedte/lissabon", "permanent": true },
    { "source": "/staedte/prague", "destination": "/staedte/prag", "permanent": true },
    { "source": "/staedte/rome", "destination": "/staedte/rom", "permanent": true },
    { "source": "/staedte/vienna", "destination": "/staedte/wien", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee; object-src 'none'; base-uri 'self'; form-action 'self' https://www.airbnb.de https://www.airbnb.com; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/legal.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
